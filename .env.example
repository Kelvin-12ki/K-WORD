# ──────────────────────────────────────────────
# K WORD — Environment Variables
# Copy this file to .env.local and fill in values.
# ──────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/kword?retryWrites=true&w=majority"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI — enables AI enrichment, evaluation, playground, writing assistant.
# The app still runs (with graceful offline fallbacks) if left empty.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Seed script password for the demo user
SEED_PASSWORD="Password123!"
