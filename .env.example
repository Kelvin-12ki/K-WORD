# ──────────────────────────────────────────────
# K WORD — Environment Variables
# Copy this file to .env.local and fill in values.
# ──────────────────────────────────────────────

# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/kword?retryWrites=true&w=majority"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI provider — enables AI enrichment, evaluation, playground, writing assistant.
# Works with any OpenAI-compatible API. Examples:
#   Gemini (free tier):  https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq (free tier):    https://api.groq.com/openai/v1
#   OpenAI:              leave AI_BASE_URL empty
# The app still runs (with graceful offline fallbacks) if left empty.
AI_API_KEY=""
AI_BASE_URL=""
AI_MODEL="gemini-2.5-flash"
# Gemini's thinking models are slow; "none" makes calls ~10x faster.
AI_REASONING_EFFORT=""

# Legacy names — still honoured if AI_API_KEY / AI_MODEL are unset
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Seed script password for the demo user
SEED_PASSWORD="Password123!"
